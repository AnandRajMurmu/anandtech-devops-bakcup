# OpenAI-compatible endpoint. NVIDIA NIM/Nemotron endpoints can use this interface.
ANANDTECH_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
ANANDTECH_LLM_API_KEY=<YOUR_API_KEY>
ANANDTECH_LLM_MODEL=<YOUR_NEMOTRON_MODEL_ID>

# Optional. Create an incoming-webhook URL for the intended Slack channel.
ANANDTECH_SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# Safety limit for Worker -> Reviewer repair cycles per unit.
ANANDTECH_MAX_REVISIONS=5

